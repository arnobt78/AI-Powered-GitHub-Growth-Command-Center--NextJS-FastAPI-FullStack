# Optional public site origin for SEO/Open Graph absolute URLs (no trailing slash).
# Set after Vercel deploy, e.g. https://your-app.vercel.app
# Falls back to VERCEL_URL, then http://localhost:3000 — never another site.
# No live public demo URL yet (see root README — deployment still open).
NEXT_PUBLIC_SITE_URL=

# URL of the locally-running (or deployed) FastAPI backend.
BACKEND_URL=http://localhost:8000
# Must be the exact same value as the backend's API_KEY (backend/.env.example)
# — sent as the Bearer token on every backend call. A mismatch causes every
# request from this frontend to silently 401 against the backend.
# Generate your own random value (then copy it into backend/.env too):
#   openssl rand -base64 32
BACKEND_API_KEY=change-me

# Auth.js's own session-cookie signing/encryption secret (unrelated to the
# GitHub OAuth app and unrelated to INTERNAL_AUTH_SECRET below — this one is
# frontend-only, never shared with the backend). Generate one:
#   openssl rand -base64 32
AUTH_SECRET=

# From your GitHub OAuth App (GitHub → Settings → Developer settings → OAuth
# Apps → New OAuth App, or https://github.com/settings/developers):
#   Homepage URL:              http://localhost:3000 (or your production domain)
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
#                               (production: https://<your-domain>/api/auth/callback/github)
# GitHub OAuth Apps support exactly ONE callback URL each — register a SEPARATE
# OAuth App for production with its own callback URL/credentials; don't try to
# reuse the dev app's Client ID/Secret in production.
# AUTH_GITHUB_ID is the "Client ID" shown immediately after registering.
AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET is generated via the "Generate a new client secret" button
# on the app's settings page — shown only once, copy it immediately.
AUTH_GITHUB_SECRET=

# HMAC shared secret — MUST be the exact same value here and in the backend's
# INTERNAL_AUTH_SECRET (backend/.env.example). Used to sign/verify the internal
# per-user auth token on every proxied request; a mismatch causes every
# authenticated request to silently 401 with no indication the two secrets
# disagree. Generate one (then copy it into backend/.env too):
#   openssl rand -base64 32
INTERNAL_AUTH_SECRET=

# HMAC shared secret — MUST be the exact same value here and in the backend's
# RECORDING_AUTH_SECRET (backend/.env.example). The backend mints a
# short-lived, repo-scoped token so its headless Playwright recorder (Phase
# 4G demo assets) can view one authenticated repo-detail page without a real
# browser session; this app's auth gate (auth.ts's authorized callback)
# verifies it. A mismatch fails silently — recordings capture the sign-in
# page instead of the dashboard, with no error surfaced. Generate one (then
# copy it into backend/.env too):
#   openssl rand -base64 32
RECORDING_AUTH_SECRET=

# --- Sentry (error monitoring) - https://sentry.io ---
# Free tier: sentry.io -> New Project -> Next.js. DSN is under Project
# Settings -> Client Keys (DSN); org/project slugs are in the project URL
# (sentry.io/organizations/<org>/projects/<project>/).
# SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN are the same value (server + browser
# both need it); NEXT_PUBLIC_ is required for the browser bundle to see it.
# Browser events tunnel through /api/monitoring instead of straight to
# Sentry's ingest domain, so ad blockers (in both normal and incognito
# browsing) that block *.sentry.io/*.ingest.* don't silently swallow errors
# — see next.config.ts's withSentryConfig(tunnelRoute).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# CI / source-map upload only (Project Settings -> Auth Tokens). Not needed
# for local dev — leave blank unless you're testing production source maps.
SENTRY_AUTH_TOKEN=
